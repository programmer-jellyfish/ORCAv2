# Google Gemini API (used only for explaining pre-computed results)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase PostgreSQL (optional - app works in offline mode without it)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key

# Local server
PORT=5000
FLASK_DEBUG=true
